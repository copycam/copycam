{
  "name": "copycam",
  "version": "0.1.1",
  "description": "Point your phone at text and it lands on your computer's clipboard, over Wi-Fi.",
  "keywords": [
    "ocr",
    "clipboard",
    "phone",
    "camera",
    "wifi",
    "privacy",
    "end-to-end-encryption"
  ],
  "homepage": "https://copycam.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copycam/copycam.git"
  },
  "bugs": {
    "url": "https://github.com/copycam/copycam/issues"
  },
  "author": "CopyCam <hello@copycam.app>",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "copycam": "server/index.js"
  },
  "files": [
    "server/",
    "shared/",
    "dist/",
    "models/",
    "licenses/",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "!**/*.test.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "prepack": "node scripts/fetch-models.mjs && npm run build",
    "models": "node scripts/fetch-models.mjs",
    "build:site": "node scripts/fetch-models.mjs && vite build --config vite.site.config.js && node scripts/build-legal.mjs",
    "notices": "node scripts/make-notices.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "dev:site": "npm run build:site && wrangler dev"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@noble/ciphers": "^2.2.0",
    "clipboardy": "^5.3.1",
    "express": "^5.2.1",
    "onnxruntime-node": "^1.27.0",
    "ppu-paddle-ocr": "^6.2.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "marked": "^18.1.1",
    "onnxruntime-web": "^1.26.0",
    "oxlint": "^1.71.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "werift": "^0.25.2",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
