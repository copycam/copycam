# Response headers for copycam.app's static files.
# The information pages load nothing from other sites; the two Cloudflare hosts
# are only for Cloudflare Web Analytics (cookieless). 'wasm-unsafe-eval' lets
# the text reader's worker compile WebAssembly: a worker takes its policy from
# its own file, which is served under /assets/ with these headers.
# The app pages (/app/, /p/) get stricter headers from the Worker
# (worker/index.js), which replace these.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY

# Fingerprinted build output: a file's name changes whenever its content does,
# so it can be cached for good. The reader's 45 MB then downloads once. Other
# sites may not load these files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
