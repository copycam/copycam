{
  // copycam.app is a static site on Cloudflare's network: no Worker code, only
  // the files `npm run build:site` writes to dist-site (the landing page, the
  // legal pages, and the _headers and _redirects rules).
  "name": "copycam",
  "compatibility_date": "2026-10-01",
  // builds the site before every deploy, so it never depends on a build
  // command being set in the Cloudflare dashboard
  "build": { "command": "npm run build:site" },
  "assets": {
    "directory": "./dist-site",
    // /privacy/ serves privacy/index.html, and /privacy redirects to /privacy/
    "html_handling": "auto-trailing-slash"
  }
}
